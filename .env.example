# Canonical URL written into the pages. Override for local dev.
# Preview deploys should keep the public origin so workers.dev is not canonical.
PUBLIC_SITE_URL=http://localhost:4321
# Indexing stays off unless this is exactly "false".
# Set PUBLIC_NOINDEX=false only on the production cutover build.
PUBLIC_NOINDEX=true
PUBLIC_SANITY_PROJECT_ID=tftrnrna
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-06-04
SANITY_STUDIO_PROJECT_ID=tftrnrna
SANITY_STUDIO_DATASET=production
